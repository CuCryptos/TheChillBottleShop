# Supabase project (Settings → API). The service role key is server-only:
# never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used for referral links, e.g. https://thechillbottleshop.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Confirmation emails via Resend (https://resend.com). Without these, signups
# still work and the email is skipped. EMAIL_FROM must use a domain verified
# in Resend, e.g. "The Chill Bottle Shop <aloha@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Staff admin at /admin. Leave either blank to keep the admin disabled.
# ADMIN_SESSION_SECRET signs the 12-hour session cookie and must be at least 32
# characters (e.g. `openssl rand -base64 48`); changing it signs everyone out.
# Use a long, random ADMIN_PASSWORD: there is no rate limiting on sign-in.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
